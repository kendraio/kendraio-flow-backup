{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "issue",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "issue",
            "blockComment": ""
        },
        {
            "type": "card",
            "blocks": [
                {
                    "type": "message",
                    "title": "Issue {{context.issue.number}} - {{context.issue.title}}"
                },
                {
                    "type": "message",
                    "message": "{{context.issue.bodyText}}"
                },
                {
                    "type": "mapping",
                    "mapping": "[context.issue][?assignees.nodes[0] != null]"
                },
                {
                    "type": "batch",
                    "blocks": [
                        {
                            "type": "mapping",
                            "mapping": "data.assignees.nodes[0].login"
                        },
                        {
                            "type": "message",
                            "message": "Assigned to {{data}}"
                        }
                    ]
                },
                {
                    "type": "template",
                    "template": "<a href=\"{{context.issue.url}}\">View on GitHub</a>"
                },
                {
                    "type": "message",
                    "message": "Created at {{context.issue.createdAtRead}} by {{context.issue.author.login}}"
                },
                {
                    "type": "mapping",
                    "mapping": "[context.issue][?editor.login != null]"
                },
                {
                    "type": "batch",
                    "blocks": [
                        {
                            "type": "message",
                            "message": "Edited at {{context.issue.updatedAt}} by {{context.issue.editor.login}}"
                        }
                    ]
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data[0]",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.comments.nodes[*].merge(@, {createdAt: formatDate(createdAt, 'T, dd/MM/yyyy'), updatedAt: formatDate(updatedAt, 'T, dd/MM/yyyy')})",
            "blockComment": ""
        },
        {
            "type": "batch",
            "blocks": [
                {
                    "type": "card",
                    "blocks": [
                        {
                            "type": "message",
                            "message": "{{body}}"
                        },
                        {
                            "type": "message",
                            "message": "{{}}"
                        },
                        {
                            "type": "message",
                            "message": "Created  at {{createdAt}} by {{author.login}}"
                        },
                        {
                            "type": "mapping",
                            "mapping": "[data][?editor.login != null]"
                        },
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "message",
                                    "message": "Edited at {{data.updatedAt}} by {{data.editor.login}}"
                                }
                            ]
                        }
                    ]
                }
            ],
            "blockComment": ""
        }
    ],
    "id": "githubissue",
    "workflowId": "githubissue",
    "adapterName": "task",
