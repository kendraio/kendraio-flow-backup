{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "issue",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "state.issue",
            "blockComment": ""
        },
        {
            "type": "variable-get",
            "name": "lineartoken",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "lineartoken",
            "blockComment": ""
        },
        {
            "type": "card",
            "blocks": [
                {
                    "type": "gosub",
                    "adapterName": "task",
                    "workflowId": "populatelinearcard"
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "state.local.issue.comments.nodes",
            "blockComment": ""
        },
        {
            "type": "batch",
            "blocks": [
                {
                    "type": "card",
                    "blocks": [
                        {
                            "type": "mapping",
                            "mapping": "data.merge(@, { createdAt: formatDate(createdAt, 'T, dd/MM/yyyy'), updatedAt: formatDate(updatedAt, 'T, dd/MM/yyyy'), assignee: assignee.name})"
                        },
                        {
                            "type": "message",
                            "title": "{{data.body}}"
                        },
                        {
                            "type": "message",
                            "message": "Created at {{data.createdAt}} by {{data.user.name}}"
                        },
                        {
                            "type": "mapping",
                            "mapping": "[data][?updatedAt != createdAt]"
                        },
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "message",
                                    "message": "Edited at {{data.updatedAt}}"
                                }
                            ]
                        },
                        {
                            "type": "switch",
                            "valueGetter": "data.assignee",
                            "cases": [
                                {
                                    "value": null,
                                    "blocks": []
                                }
                            ],
                            "default": {
                                "blocks": [
                                    {
                                        "type": "message",
                                        "message": "Assigned to {{data.assignee}}"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "switch",
                            "valueGetter": "data.archivedAt",
                            "cases": [
                                {
                                    "value": null,
                                    "blocks": []
                                }
                            ],
                            "default": {
                                "blocks": [
                                    {
                                        "type": "mapping",
                                        "mapping": "data.merge(@, {archivedAt: formatDate(archivedAt, 'T, dd/MM/yyyy')})"
                                    },
                                    {
                                        "type": "message",
                                        "message": "Archived at {{data.archivedAt}}"
                                    }
                                ]
                            }
                        }
                    ]
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "state.local.issue",
            "blockComment": ""
        },
        {
            "type": "switch",
            "valueGetter": "data.parent",
            "cases": [
                {
                    "value": null,
                    "blocks": []
                }
            ],
            "default": {
                "blocks": [
                    {
                        "type": "actions",
                        "buttons": [
                            {
                                "label": "Parent Issue",
                                "color": "primary",
                                "blocks": [
                                    {
                                        "type": "context",
                                        "contextPath": "newValue",
                                        "contextBlocks": [
                                            {
                                                "type": "mapping",
                                                "mapping": "{id: data.parent.id, lineartoken: context.lineartoken.lineartoken}"
                                            },
                                            {
                                                "type": "graphql",
                                                "endpoint": "https://api.linear.app/graphql",
                                                "query": "query MyQuery($id: String!) {\n    issue(id: $id) {\n        id\n        title \n        description \n        createdAt \n        updatedAt \n        archivedAt \n        creator {\n            name\n        }\n        assignee {\n            name\n        } \n        parent {\n            id\n        } \n        children {\n            nodes {\n                title\n                id\n            }\n        } \n        comments { \n            nodes {\n                createdAt \n                updatedAt \n                archivedAt \n                body \n                editedAt \n                user {\n                    name\n                }\n            }\n        }\n    }\n}",
                                                "variables": {
                                                    "id": "data.id"
                                                },
                                                "headers": {
                                                    "authorization": "data.lineartoken"
                                                },
                                                "allowFirst": false,
                                                "allowEmpty": false
                                            },
                                            {
                                                "type": "mapping",
                                                "mapping": "data.data.issue.merge(@, {\n    source:  `Linear`,\n    asset:   title,\n    preview: description,\n    createdAtSort: formatDate(createdAt, 'yyyy/MM/dd, T'),    createdAtRead: formatDate(createdAt, 'T, dd/MM/yyyy'),    updatedAt: formatDate(updatedAt, 'T, dd/MM/yyyy')\n})"
                                            },
                                            {
                                                "type": "variable-set",
                                                "name": "issue"
                                            }
                                        ],
                                        "blocks": [
                                            {
                                                "type": "launch",
                                                "adapter": "task",
                                                "workflowId": "linearissueredirect"
                                            }
                                        ]
                                    }
                                ],
                                "enabled": true
                            }
                        ]
                    }
                ]
            },
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "state.local.issue.children.nodes",
            "blockComment": ""
        },
        {
            "type": "switch",
            "valueGetter": "data[0]",
            "cases": [
                {
                    "value": null,
                    "blocks": []
                }
            ],
            "default": {
                "blocks": [
                    {
                        "type": "grid",
                        "gridOptions": {
                            "pagination": true,
                            "paginationPageSize": 10,
                            "defaultColDef": {
                                "autoHeight": true,
                                "resizable": true,
                                "sortable": true
                            }
                        },
                        "passThrough": false,
                        "firstRowHeaders": false,
                        "columnDefs": [
                            {
                                "field": "title",
                                "headerName": "Sub-issues"
                            },
                            {
                                "field": "details",
                                "headerName": "",
                                "cellRenderer": "workflowRenderer",
                                "cellRendererParams": {
                                    "blocks": [
                                        {
                                            "type": "actions",
                                            "buttons": [
                                                {
                                                    "label": "Details",
                                                    "color": "primary",
                                                    "blocks": [
                                                        {
                                                            "type": "context",
                                                            "contextPath": "newValue",
                                                            "contextBlocks": [
                                                                {
                                                                    "type": "mapping",
                                                                    "mapping": "{id: data.id, lineartoken: context.lineartoken.lineartoken}"
                                                                },
                                                                {
                                                                    "type": "graphql",
                                                                    "endpoint": "https://api.linear.app/graphql",
                                                                    "query": "query MyQuery($id: String!) {\n    issue(id: $id) {\n        id\n        title \n        description \n        createdAt \n        updatedAt \n        archivedAt \n        creator {\n            name\n        }\n        assignee {\n            name\n        } \n        parent {\n            id\n        } \n        children {\n            nodes {\n                title\n                id\n            }\n        } \n        comments { \n            nodes {\n                createdAt \n                updatedAt \n                archivedAt \n                body \n                editedAt \n                user {\n                    name\n                }\n            }\n        }\n    }\n}",
                                                                    "variables": {
                                                                        "id": "data.id"
                                                                    },
                                                                    "headers": {
                                                                        "authorization": "data.lineartoken"
                                                                    },
                                                                    "allowFirst": false,
                                                                    "allowEmpty": false
                                                                },
                                                                {
                                                                    "type": "mapping",
                                                                    "mapping": "data.data.issue.merge(@, {\n    source:  `Linear`,\n    asset:   title,\n    preview: description,\n    createdAtSort: formatDate(createdAt, 'yyyy/MM/dd, T'),    createdAtRead: formatDate(createdAt, 'T, dd/MM/yyyy'),    updatedAt: formatDate(updatedAt, 'T, dd/MM/yyyy')\n})",
                                                                    "blockComment": ""
                                                                },
                                                                {
                                                                    "type": "variable-set",
                                                                    "name": "issue"
                                                                }
                                                            ],
                                                            "blocks": [
                                                                {
                                                                    "type": "launch",
                                                                    "adapter": "task",
                                                                    "workflowId": "linearissueredirect"
                                                                }
                                                            ]
                                                        }
                                                    ],
                                                    "enabled": true
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
            "blockComment": ""
        }
    ],
    "id": "linearissue",
    "workflowId": "linearissue",
    "adapterName": "task",
    "created": "2024-10-02T14:26:24.898Z",
    "tags": [],
