{
    "blocks": [
        {
            "type": "template",
            "template": "<img height='50' width='50' src='{{state.local.issue.creator.avatarUrl}}' />",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "state.local.issue.merge(@, {\n    createdAtRead: formatDate(createdAt, `T, dd/MM/yyyy`),\n    assignee: assignee.name\n})",
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "message",
            "title": "{{data.title}}",
            "blockComment": ""
        },
        {
            "type": "message",
            "message": "{{data.description}}",
            "blockComment": ""
        },
        {
            "type": "message",
            "message": "Created at {{createdAtRead}} by {{data.creator.name}}",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "[data][?updatedAt != createdAtRead]",
            "blockComment": ""
        },
        {
            "type": "batch",
            "blocks": [
                {
                    "type": "message",
                    "message": "Edited at {{data.updatedAt}}"
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "[state.local.issue][?assignee != null]",
            "blockComment": ""
        },
        {
            "type": "batch",
            "blocks": [
                {
                    "type": "message",
                    "message": "Assigned to {{data.assignee.name}}"
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "[state.local.issue][?archivedAt != null]",
            "blockComment": ""
        },
        {
            "type": "batch",
            "blocks": [
                {
                    "type": "mapping",
                    "mapping": "data.merge(@, {archivedAt: formatDate(archivedAt, 'T, dd/MM/yyyy')})"
                },
                {
                    "type": "message",
                    "message": "Archived at {{data.archivedAt}}"
                }
            ],
            "blockComment": ""
        }
    ],
