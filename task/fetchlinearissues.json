{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "lineartoken",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "lineartoken",
            "blockComment": ""
        },
        {
            "type": "http",
            "method": "post",
            "useProxy": true,
            "endpoint": {
                "protocol": "https:",
                "host": "api.linear.app",
                "pathname": "/graphql"
            },
            "headers": {
                "authorization": "data.lineartoken"
            },
            "payload": "{ query: '{issues{nodes{id title description createdAt updatedAt archivedAt creator {name}assignee {name} parent {id} children {nodes {id title}} comments { nodes {createdAt updatedAt archivedAt body editedAt user{name}}}}}}'}",
            "useOldBucketDataFormat": true,
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "mapping",
            "mapping": "data.data.issues.nodes[*].merge(@, {\n    source:  `Linear`,\n    asset:   title,\n    preview: description,\n    createdAtSort: formatDate(createdAt, 'yyyy/MM/dd, T'),\n    createdAtRead: formatDate(createdAt, 'T, dd/MM/yyyy'),\n    updatedAt: formatDate(updatedAt, 'T, dd/MM/yyyy')\n})",
            "blockComment": ""
        },
        {
            "type": "switch",
            "valueGetter": "data",
            "cases": [
                {
                    "value": null,
                    "blocks": [
                        {
                            "type": "message",
                            "message": "Linear Data not fetched"
                        }
                    ]
                }
            ],
            "default": {
                "blocks": [
                    {
                        "type": "message",
                        "message": "Linear Data fetched"
                    }
                ]
            },
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "linear",
            "blockComment": ""
        }
    ],
    "id": "fetchlinearissues",
    "workflowId": "fetchlinearissues",
    "adapterName": "task",
