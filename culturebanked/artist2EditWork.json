{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "culturebanked-hasura",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "hasura",
            "blockComment": "Hasura Key"
        },
        {
            "type": "mapping",
            "mapping": "{\n    \"id\":  to_number(context.queryParams.id)\n}",
            "blockComment": ""
        },
        {
            "type": "graphql",
            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "query GetAssetById($asset_id: Int!) {\n  assets(limit: 1, where: { asset_id: { _eq: $asset_id } }) {\n    asset_id\n    asset_title\n    width\n    height\n    medium\n    asset_after\n    location\n    license_detail {\n      license_id\n      name\n    }\n    asset_manager {\n      asset_manager_id\n      name\n    }\n  }\n}",
            "variables": {
                "asset_id": "data.id"
            },
            "headers": {
                "x-hasura-admin-secret": "context.hasura.token"
            },
            "allowFirst": false,
            "allowEmpty": false
        },
        {
            "type": "mapping",
            "mapping": "data.data.assets[0].merge(@, {\n    \"asset_id_owner\": asset_id,\n    \"asset_id_beneficiary\": asset_id,\n    \"asset_id_vendor\": asset_id,\n    \"license_detail_id\": license_detail.license_id,\n    \"asset_manager_id\": asset_manager.asset_manager_id\n})",
            "blockComment": "create properties for gosub"
        },
        {
            "type": "form",
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "asset_title": {
                        "title": "Asset",
                        "type": "string"
                    },
                    "width": {
                        "title": "Width (mm)",
                        "type": "string"
                    },
                    "height": {
                        "title": "Height (mm)",
                        "type": "string"
                    },
                    "medium": {
                        "title": "Medium",
                        "type": "string"
                    },
                    "asset_after": {
                        "title": "After",
                        "type": "string"
                    },
                    "location": {
                        "title": "Location",
                        "type": "string"
                    },
                    "physicalLocation": {
                        "title": "Physical Location",
                        "type": "string"
                    },
                    "asset_id_owner": {
                        "title": "Owners",
                        "type": "string"
                    },
                    "asset_id_beneficiary": {
                        "title": "Beneficiaries",
                        "type": "string"
                    },
                    "asset_id_vendor": {
                        "title": "Vendors",
                        "type": "string"
                    },
                    "license_detail_id": {
                        "type": "string",
                        "title": "License details"
                    },
                    "asset_manager_id": {
                        "type": "string",
                        "title": "Asset Manager"
                    }
                }
            },
            "uiSchema": {
                "location": {
                    "ui:widget": "remote-image"
                },
                "asset_id_owner": {
                    "ui:widget": "blocks",
                    "blocksConfig": {
                        "blocks": [
                            {
                                "type": "gosub",
                                "adapterName": "culturebanked",
                                "workflowId": "artist2EditOwnerSplit"
                            }
                        ]
                    }
                },
                "asset_id_beneficiary": {
                    "ui:widget": "blocks",
                    "blocksConfig": {
                        "blocks": [
                            {
                                "type": "gosub",
                                "adapterName": "culturebanked",
                                "workflowId": "artist2EditBeneficiarySplit"
                            }
                        ]
                    }
                },
                "asset_id_vendor": {
                    "ui:widget": "blocks",
                    "blocksConfig": {
                        "blocks": [
                            {
                                "type": "gosub",
                                "adapterName": "culturebanked",
                                "workflowId": "artist2EditAssetVendor"
                            }
                        ]
                    }
                },
                "license_detail_id": {
                    "ui:widget": "blocks",
                    "blocksConfig": {
                        "blocks": [
                            {
                                "type": "gosub",
                                "adapterName": "culturebanked",
                                "workflowId": "artist2SelectLicense"
                            }
                        ]
                    }
                },
                "asset_manager_id": {
                    "ui:widget": "blocks",
                    "blocksConfig": {
                        "blocks": [
                            {
                                "type": "gosub",
                                "adapterName": "culturebanked",
                                "workflowId": "artist2-select-asset-manager"
                            }
                        ]
                    }
                }
            },
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.merge(@, {\n    \"new_license_id\": license_id.licenseSelected || license_detail_id,\n    \"new_asset_manager_id\": asset_manager_id.managerSelected || asset_manager_id\n})",
            "blockComment": ""
        },
        {
            "type": "graphql",
            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "mutation UpdateAssetById(\n  $asset_id: Int!,\n  $asset_title: String,\n  $width: Int!,\n  $height: Int!,\n  $medium: String,\n  $asset_after: String,\n  $location: String,\n  $new_license_id: Int,\n  $new_asset_manager_id: Int\n) {\n  update_assets(\n    where: { asset_id: { _eq: $asset_id } }\n    _set: {\n      asset_title: $asset_title,\n      width: $width,\n      height: $height,\n      medium: $medium,\n      asset_after: $asset_after,\n      location: $location,\n      license_id: $new_license_id,\n      asset_manager_id: $new_asset_manager_id\n    }\n  ) {\n    affected_rows\n    returning {\n      asset_id\n      asset_title\n      license_id\n      asset_manager_id\n    }\n  }\n}",
            "variables": {
                "asset_id": "data.asset_id",
                "asset_title": "data.asset_title",
                "width": "data.width",
                "height": "data.height",
                "medium": "data.medium",
                "asset_after": "data.asset_after",
                "location": "data.location",
                "new_license_id": "data.new_license_id",
                "new_asset_manager_id": "data.new_asset_manager_id"
            },
            "headers": {
                "x-hasura-admin-secret": "context.hasura.token"
            },
            "allowFirst": false,
            "allowEmpty": false
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Back to Assets List",
                    "color": "default",
                    "blocks": [
                        {
                            "type": "launch",
                            "adapter": "culturebanked",
                            "workflowId": "artist2Assets"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": ""
        }
    ],
