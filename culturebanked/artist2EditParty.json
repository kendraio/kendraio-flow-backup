            "type": "graphql",
            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "query GetBeneficiaryById ($beneficiary_id: Int!) {\n  beneficiaries (limit: 1, where: { beneficiary_id: { _eq: $beneficiary_id } }) {\n    beneficiary_id\n    name\n  }\n}",
            "variables": {
