            "type": "form",
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "name": {
                        "title": "Name",
                        "type": "string"
                    }
                }
            },
            "uiSchema": {}
        },
        {
            "type": "graphql",
            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "mutation UpdateBeneficiaryById($beneficiary_id: Int!, $new_name: String!) {\n  update_beneficiaries(\n    where: { beneficiary_id: { _eq: $beneficiary_id } },\n    _set: { name: $new_name }\n  ) {\n    returning {\n      beneficiary_id\n      name\n    }\n  }\n}",
            "variables": {
                "beneficiary_id": "data.beneficiary_id",
                "new_name": "data.name"
            },
            "headers": {
