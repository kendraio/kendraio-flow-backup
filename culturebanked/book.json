{
    "blocks": [
        {
            "type": "form",
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "boonbooks": {
                        "title": "Boon Books API Key",
                        "type": "password"
                    }
                }
            },
            "uiSchema": {},
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "api_keys",
            "blockComment": ""
        },
        {
            "type": "http",
            "method": "post",
            "notify": false,
            "endpoint": {
                "protocol": "https:",
                "host": "9597d8-c1.myshopify.com",
                "pathname": "/admin/api/2025-07/graphql.json"
            },
            "headers": {
                "Content-Type": "'application/json'",
                "X-Shopify-Access-Token": "data.boonbooks"
            },
            "payload": "{ query: 'query { products(first: 5) { edges { node { id title description vendor tags featuredMedia { preview { image { url altText } } } } } } }' }",
            "useProxy": true,
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "mapping",
            "mapping": "data.data.products.edges[*].node",
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "grid",
            "gridOptions": {
                "defaultColDef": {
                    "autoHeight": true,
                    "resizable": true,
                    "sortable": true
                },
                "pagination": true,
                "paginationPageSize": 5,
                "rowSelection": "multiple",
                "suppressRowClickSelection": true
            },
            "passThrough": false,
            "firstRowHeaders": false,
            "columnDefs": [
                {
                    "width": 50,
                    "resizable": false,
                    "checkboxSelection": true
                },
                {
                    "field": "featuredMedia.preview.image.url",
                    "headerName": "Image"
                },
                {
                    "field": "title",
                    "headerName": "Title"
                },
                {
                    "field": "description",
                    "headerName": "Description"
                },
                {
                    "field": "vendor",
                    "headerName": "Vendor"
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "{items: data}",
            "blockComment": ""
        },
        {
            "type": "init"
        },
        {
            "type": "form",
            "label": "Create a list",
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "title": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string"
                                },
                                "vendor": {
                                    "type": "string"
                                },
                                "Quantity": {
                                    "type": "number",
                                    "title": "Quantity",
                                    "default": 1
                                }
                            }
                        }
                    }
                }
            },
            "uiSchema": {
                "items": {
                    "ui:widget": "table",
                    "colHeadings": [
                        "Title",
                        "Description",
                        "Vendor",
                        "Quantity"
                    ],
                    "allowAdd": false,
                    "allowRemove": false,
                    "items": {
                        "title": {
                            "ui:widget": "readonly"
                        },
                        "description": {
                            "ui:widget": "readonly"
                        },
                        "vendor": {
                            "ui:widget": "readonly"
                        }
                    }
                }
            },
            "blockComment": ""
        },
        {
            "type": "card",
            "blocks": [
                {
                    "type": "template",
                    "template": "<p>Here is my order:</p><ul>{{#each data.items}}<li><b>{{Quantity}} x</b> {{title}} (from {{vendor}}) </li>{{/each}}</ul>"
                }
            ],
            "blockComment": ""
        }
