                            "type": "object",
                            "properties": {
                                "Title": {
                                    "type": "string"
                                },
                                "Description": {
                                    "type": "string"
                                },
                                "Quantity": {
                                    "type": "number",
                                    "title": "Quantity",
                                    "default": 1
                                }
                            }
                        }
                    }
                }
            },
            "uiSchema": {
                "items": {
                    "ui:widget": "table",
                    "colHeadings": [
                        "Title",
                        "Description",
                        "Quantity"
                    ],
                    "allowAdd": false,
                    "allowRemove": false,
                    "items": {
