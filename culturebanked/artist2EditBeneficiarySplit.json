            "query": "mutation UpdateSplitsBeneficiaries($list: [splits_beneficiaries_insert_input!]!, $asset_id: Int!) {\n  delete_splits_beneficiaries(where: { asset_id: { _eq: $asset_id } }) {\n    affected_rows\n  }\n  insert_splits_beneficiaries(objects: $list) {\n    affected_rows\n    returning {\n      asset_id\n      beneficiary_id\n      splits\n    }\n  }\n}",
