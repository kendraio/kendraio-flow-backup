            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.merge(@, {\n    \"new_license_id\": license_detail_id.licenseSelected || license_detail_id.license_detail_id,\n    \"new_asset_manager_id\": asset_manager_id.managerSelected || asset_manager_id.asset_manager_id\n})",
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "graphql",
            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "mutation InsertAssetById(\n  $asset_title: String,\n  $width: Int!,\n  $height: Int!,\n  $medium: String,\n  $asset_after: String,\n  $location: String,\n  $license_id: Int,\n  $asset_manager_id: Int\n) {\n  insert_assets(\n    objects: {\n      asset_title: $asset_title,\n      width: $width,\n      height: $height,\n      medium: $medium,\n      asset_after: $asset_after,\n      location: $location,\n      license_id: $license_id,\n      asset_manager_id: $asset_manager_id\n    }\n  ) {\n    returning {\n      asset_id\n      asset_title\n      license_id\n      asset_manager_id\n    }\n  }\n}",
            "variables": {
                "asset_title": "data.asset_title",
                "width": "data.width",
                "height": "data.height",
                "medium": "data.medium",
                "asset_after": "data.asset_after",
                "location": "data.location",
                "license_id": "data.new_license_id",
                "asset_manager_id": "data.new_asset_manager_id"
            },
            "headers": {
                "x-hasura-admin-secret": "context.hasura.token"
            },
            "allowFirst": false,
            "allowEmpty": false
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Back to assets list",
                    "color": "default",
                    "blocks": [
                        {
                            "type": "launch",
                            "adapter": "culturebanked",
                            "workflowId": "artist2Assets"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": ""
        }
    ],
