            "uiSchema": {}
        },
        {
            "type": "graphql",
            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "mutation UpdateMarketPlatformById($market_platform_id: Int!, $new_name: String!) {\n  update_market_platforms(\n    where: { market_platform_id: { _eq: $market_platform_id } },\n    _set: { name: $new_name }\n  ) {\n    returning {\n      market_platform_id\n      name\n    }\n  }\n}",
            "variables": {
