            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "query GetMarketPlatformById($market_platform_id: Int!) {\n  market_platforms(limit: 1, where: { market_platform_id: { _eq: $market_platform_id } }) {\n   market_platform_id\n    name\n\t}\n}",
