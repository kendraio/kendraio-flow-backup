{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "culturebanked-hasura",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "hasura",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "{\n    \"id\":  to_number(context.queryParams.id),\n    \"beneficiary_name\": context.queryParams.beneficiary_name\n}",
            "blockComment": "queryParam Id"
        },
        {
            "type": "template",
            "template": "<br><h3>Assets By {{data.beneficiary_name}}</h3>",
            "blockComment": "Assets by Beneficiary"
        },
        {
            "type": "graphql",
            "endpoint": "https://culturebankedartist2.hasura.app/v1/graphql",
            "query": "query GetAssetsByBeneficiary ($beneficiary_id: Int!) {\n  assets (where: { assets_beneficiaries: { beneficiary_id: { _eq: $beneficiary_id } }}) {\n    asset_id\n    asset_title\n  }\n}",
            "variables": {
                "beneficiary_id": "data.id"
            },
            "headers": {
                "x-hasura-admin-secret": "context.hasura.token"
            },
            "allowFirst": false,
            "allowEmpty": false
        },
        {
            "type": "mapping",
            "mapping": "data.data.assets",
            "blockComment": ""
        },
        {
            "type": "grid",
            "gridOptions": {},
            "passThrough": false,
            "firstRowHeaders": false,
            "columnDefs": [
                {
                    "headerName": "Asset title",
                    "field": "asset_title"
                },
                {
                    "headerName": "Operations",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "actions",
                                "buttons": [
                                    {
                                        "label": "Edit Asset",
                                        "blocks": [
                                            {
                                                "type": "launch",
                                                "adapter": "culturebanked",
                                                "workflowId": "artist2EditWork",
                                                "context": {
                                                    "id": "data.asset_id"
                                                }
                                            }
                                        ],
                                        "enabled": true
                                    }
                                ]
                            }
                        ]
                    }
                }
            ],
            "blockComment": ""
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Back to Beneficiaries List",
                    "color": "default",
                    "blocks": [
                        {
                            "type": "launch",
                            "adapter": "culturebanked",
                            "workflowId": "artist2Beneficiaries"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": ""
        }
