{
    "blocks": [
        {
            "type": "form",
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "password",
                        "title": "Private Token",
                        "default": ""
                    },
                    "shopName": {
                        "type": "string",
                        "title": "Shop Hostname",
                        "default": "example.myshopify.com"
                    },
                    "productsAmount": {
                        "type": "number",
                        "title": "Products Amount",
                        "default": 40
                    }
                }
            },
            "uiSchema": {},
            "blockComment": ""
        },
        {
            "type": "init",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "!data || {\n    \"token\": data.token,\n    \"shopName\": data.shopName,\n    \"productsAmount\": data.productsAmount,\n    \"host\": join('', [data.shopName, `/admin/api/2025-10/graphql.json`])\n}\n",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "savedData",
            "blockComment": "savedData: query data"
        },
        {
            "type": "http",
            "method": "post",
            "notify": false,
            "endpoint": {
                "protocol": "https:",
                "valueGetters": {
                    "host": "context.savedData.host"
                }
            },
            "headers": {
                "Content-Type": "'application/json'",
                "X-Shopify-Access-Token": "context.savedData.token"
            },
            "payload": "{ query: 'query { products(first: 250) { edges { node { title vendor featuredMedia { preview { image { url altText } } } createdAt publishedAt status } } } }' }",
            "useProxy": true,
            "onError": {
                "blocks": [
                    {
                        "type": "card",
                        "blocks": [
                            {
                                "type": "template",
                                "template": "Error with submission:<p>{{data.error.error}} - {{data.error.error_description}}</p>"
                            }
                        ]
                    }
                ]
            },
            "blockComment": "Shopify GraphQL"
        },
        {
            "type": "mapping",
            "mapping": "data.data.products.edges[?node.featuredMedia.preview.image.url].node\n",
            "blockComment": "Only show products with an image"
        },
        {
            "type": "switch",
            "valueGetter": "data.products",
            "cases": [
                {
                    "value": null,
                    "blocks": [
                        {
                            "type": "card",
                            "blocks": [
                                {
                                    "type": "template",
                                    "template": "No data to display!"
                                }
                            ]
                        }
                    ]
                }
            ],
            "default": {
                "blocks": [
                    {
                        "type": "template",
                        "template": "API successful"
                    }
                ]
            },
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "state.resultsSaved",
            "blockComment": "resultsSaved: shop items array"
        },
        {
            "type": "grid",
            "gridOptions": {
                "floatingFilter": true,
                "pagination": true,
                "paginationPageSize": 20,
                "rowSelection": "multiple",
                "suppressRowClickSelection": true
            },
            "columnDefs": [
                {
                    "width": 20,
                    "resizable": false,
                    "checkboxSelection": true
                },
                {
                    "headerName": "Title",
                    "field": "title",
                    "filter": "agTextColumnFilter",
                    "filterParams": {
                        "applyButton": true,
                        "resetButton": true
                    }
                },
                {
                    "headerName": "Vendor",
                    "field": "vendor",
                    "filter": "agTextColumnFilter",
                    "filterParams": {
                        "applyButton": true,
                        "resetButton": true
                    }
                },
                {
                    "headerName": "Created At",
                    "field": "createdAt",
                    "filter": "agTextColumnFilter",
                    "filterParams": {
                        "applyButton": true,
                        "resetButton": true
                    }
                },
                {
                    "headerName": "Published At",
                    "field": "publishedAt",
                    "filter": "agTextColumnFilter",
                    "filterParams": {
                        "applyButton": true,
                        "resetButton": true
                    }
                },
                {
                    "headerName": "Status",
                    "field": "status",
                    "filter": "agTextColumnFilter",
                    "filterParams": {
                        "applyButton": true,
                        "resetButton": true
                    }
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "state.local.resultsSaved",
            "blockComment": ""
        },
        {
            "type": "batch",
            "flex": true,
            "blocks": [
                {
                    "type": "card",
                    "blocks": [
                        {
                            "type": "template",
                            "template": "<b class='truncate'>{{data.title}}</b>"
                        },
                        {
                            "type": "template",
                            "template": "<img width='200' height='300' src='{{data.featuredMedia.preview.image.url}}' />"
                        },
                        {
                            "type": "actions",
                            "buttons": [
                                {
                                    "label": "Go to product",
                                    "color": "primary",
                                    "blocks": [
                                        {
                                            "type": "template",
                                            "template": "<a href='context.savedData.host/products/resultsSaved.title'></>"
                                        }
                                    ],
                                    "enabled": true
                                }
                            ]
                        }
                    ]
                }
            ],
            "blockComment": "Card Gallery"
        }
    ],
    "id": "products",
    "workflowId": "products",
    "adapterName": "shopify",
    "created": "2025-11-18T14:57:41.286Z",
    "tags": [],
    "updated": "2025-11-18T14:57:41.203Z",
    "modified": "2025-11-18T14:57:41.203Z",
    "title": "Shopify Products"
}