{
    "blocks": [
        {
            "type": "debug",
            "open": 0,
            "showData": false,
            "showContext": false,
            "showState": false,
            "blockComment": "Inlined gosub from freecords/batchnameform"
        },
        {
            "type": "form",
            "hasSubmit": false,
            "jsonSchema": {
                "type": "object",
                "label": "Save name",
                "properties": {
                    "batchName": {
                        "title": "Batch name",
                        "type": "string",
                        "default": "Freecords"
                    }
                }
            },
            "uiSchema": {},
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.batchName",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "state.batchName",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "{ hideBlanks: true }",
            "blockComment": "\u2699\ufe0f Set initial state for hide blanks"
        },
        {
            "type": "form",
            "hasSubmit": false,
            "emitOnInit": true,
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "hideBlanks": {
                        "type": "boolean",
                        "title": "Hide blank ISRCs",
                        "default": true
                    }
                }
            },
            "uiSchema": {},
            "blockComment": "\u2611\ufe0f Display 'Hide blank ISRCs' checkbox"
        },
        {
            "type": "mapping",
            "mapping": "data.hideBlanks",
            "blockComment": "\ud83d\udc49 Extract boolean from form output"
        },
        {
            "type": "context-save",
            "key": "hideBlanks",
            "blockComment": "\ud83d\udcbe Save 'hideBlanks' preference to context"
        },
        {
            "type": "init",
            "blockComment": "\ud83d\ude80 Initialise workflow"
        },
        {
            "type": "variable-get",
            "name": "freecords",
            "blockComment": "\ud83d\udd11 Get Freecords API credentials"
        },
        {
            "type": "mapping",
            "mapping": "data && merge(data, {\n  endpoint: data.endpoint && (\n    ends_with(data.endpoint, `/`) && data.endpoint\n    || join(``, [data.endpoint, `/`])\n  ) || data.endpoint\n})\n",
            "blockComment": "\ud83d\udd27 Normalise Freecords endpoint to end with a slash"
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "context-save",
            "key": "api",
            "blockComment": "\ud83d\udcbe Save API credentials to context"
        },
        {
            "type": "mapping",
            "mapping": "{api_token: data.key}",
            "blockComment": "\ud83d\udd27 Prepare API token for request"
        },
        {
            "type": "http",
            "method": "get",
            "useProxy": true,
            "endpoint": {
                "protocol": "https:",
                "host": "app.freecords.com/api/v1.1",
                "pathname": "/obj/song",
                "valueGetters": {
                    "query": "data"
                }
            },
            "blockComment": "\ud83d\udce1 Fetch all songs from API \ud83c\udf10x1"
        },
        {
            "type": "mapping",
            "mapping": "data.data[*].merge(@, {\n    created: @.\"Created Date\",\n    modified: @.\"Modified Date\",\n    artwork: @.\"Cover Photo\"\n})",
            "blockComment": "\u2728 Standardise field names"
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, {\n    created: formatDate(created, 'yyyy/MM/dd, T'),\n    modified: formatDate(modified, 'yyyy/MM/dd, T')\n})",
            "blockComment": "\ud83d\udcc5 Format date fields for display"
        },
        {
            "type": "mapping",
            "mapping": "context.hideBlanks && data[?ISRC != null] || data",
            "blockComment": "\ud83d\uddd1\ufe0f Filter out blank ISRCs if toggled"
        },
        {
            "type": "grid",
            "gridOptions": {
                "rowSelection": "multiple",
                "rowMultiSelectWithClick": true,
                "pagination": true,
                "paginationPageSize": 20,
                "defaultColDef": {
                    "autoHeight": true,
                    "resizable": true,
                    "sortable": true
                }
            },
            "passThrough": false,
            "firstRowHeaders": false,
            "columnDefs": [
                {
                    "headerCheckboxSelection": true,
                    "checkboxSelection": true,
                    "width": 70,
                    "suppressSizeToFit": true
                },
                {
                    "field": "artwork",
                    "headerName": "Artwork",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "template",
                                "template": "<img width='150' height='150' src='{{data.artwork}}' />"
                            }
                        ]
                    }
                },
                {
                    "field": "Artist",
                    "headerName": "Artist"
                },
                {
                    "field": "Name",
                    "headerName": "Title"
                },
                {
                    "field": "created",
                    "headerName": "Created"
                },
                {
                    "field": "modified",
                    "headerName": "Modified"
                },
                {
                    "field": "ISRC",
                    "headerName": "ISRC",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "message",
                                "message": "{{data.ISRC}}"
                            }
                        ]
                    }
                },
                {
                    "field": "Details",
                    "headerName": "",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "mapping",
                                "mapping": "data.ISRC"
                            },
                            {
                                "type": "switch",
                                "valueGetter": "data",
                                "cases": [
                                    {
                                        "value": null,
                                        "blocks": []
                                    }
                                ],
                                "default": {
                                    "blocks": [
                                        {
                                            "type": "actions",
                                            "buttons": [
                                                {
                                                    "label": "Details",
                                                    "color": "primary",
                                                    "blocks": [
                                                        {
                                                            "type": "variable-set",
                                                            "name": "isrc"
                                                        },
                                                        {
                                                            "type": "launch",
                                                            "adapter": "freecords",
                                                            "workflowId": "getsongdetails"
                                                        }
                                                    ],
                                                    "enabled": true
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ],
            "blockComment": "\ud83d\udcca Display songs in data grid"
        },
        {
            "type": "mapping",
            "mapping": "data[?ISRC != \"\"]",
            "blockComment": "\ud83d\udd0e Filter selection for valid ISRCs"
        },
        {
            "type": "context-save",
            "key": "state.selections",
            "blockComment": "\ud83d\udcbe Save 'state.selections' to context"
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Prepare upload Selection for later automatic upload on completion",
                    "enabledGetter": "data[0]",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "context",
                                    "contextPath": "song",
                                    "contextBlocks": [
                                        {
                                            "type": "context-save",
                                            "key": "song"
                                        }
                                    ],
                                    "blocks": [
                                        {
                                            "type": "switch",
                                            "valueGetter": "context.api.key != null && context.song.ISRC != null",
                                            "cases": [
                                                {
                                                    "value": true,
                                                    "blocks": [
                                                        {
                                                            "type": "debug",
                                                            "consoleLog": true
                                                        },
                                                        {
                                                            "type": "debug",
                                                            "consoleLog": true
                                                        },
                                                        {
                                                            "type": "http",
                                                            "method": "get",
                                                            "useProxy": true,
                                                            "endpoint": {
                                                                "protocol": "https:",
                                                                "host": "app.freecords.com/api/v1.1/wf",
                                                                "pathname": "/get_song",
                                                                "valueGetters": {
                                                                    "query": "{api_token: context.api.key, ISRC: context.song.ISRC}"
                                                                }
                                                            },
                                                            "skipInit": false,
                                                            "blockComment": "Run directly with passed data"
                                                        },
                                                        {
                                                            "type": "debug",
                                                            "consoleLog": true
                                                        }
                                                    ]
                                                }
                                            ],
                                            "default": {
                                                "blocks": [
                                                    {
                                                        "type": "message",
                                                        "message": "Skipping Upload Prep: Missing API Key or ISRC."
                                                    }
                                                ]
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "enabled": null
                }
            ],
            "blockComment": "\ud83d\udce4 Define 'Upload Selection' button and prep logic \ud83c\udf10x1"
        }
    ],
