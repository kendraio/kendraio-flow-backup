{
    "blocks": [
        {
            "type": "gosub",
            "adapterName": "freecords",
            "workflowId": "batchnameform",
            "blockComment": "\ud83c\udff7\ufe0f Run sub-workflow for batch name"
        },
        {
            "type": "mapping",
            "mapping": "{ hideBlanks: true }",
            "blockComment": "\u2699\ufe0f Set initial state for hide blanks"
        },
        {
            "type": "form",
            "hasSubmit": false,
            "emitOnInit": true,
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "hideBlanks": {
                        "type": "boolean",
                        "title": "Hide blank ISRCs",
                        "default": true
                    }
                }
            },
            "uiSchema": {},
            "blockComment": "\u2611\ufe0f Display 'Hide blank ISRCs' checkbox"
        },
        {
            "type": "mapping",
            "mapping": "data.hideBlanks",
            "blockComment": "\ud83d\udc49 Extract boolean from form output"
        },
        {
            "type": "context-save",
            "key": "hideBlanks",
            "blockComment": "\ud83d\udcbe Save 'hideBlanks' preference to context"
        },
        {
            "type": "init",
            "blockComment": "\ud83d\ude80 Initialise workflow"
        },
        {
            "type": "variable-get",
            "name": "freecords",
            "blockComment": "\ud83d\udd11 Get Freecords API credentials"
        },
        {
            "type": "context-save",
            "key": "api",
            "blockComment": "\ud83d\udcbe Save API credentials to context"
        },
        {
            "type": "mapping",
            "mapping": "{api_token: data.key}",
            "blockComment": "\ud83d\udd27 Prepare API token for request"
        },
        {
            "type": "http",
            "method": "get",
            "useProxy": true,
            "endpoint": {
                "protocol": "https:",
                "host": "app.freecords.com/api/v1.1",
                "pathname": "/obj/song",
                "valueGetters": {
                    "query": "data"
                }
            },
            "blockComment": "\ud83d\udce1 Fetch all songs from API"
        },
        {
            "type": "mapping",
            "mapping": "data.data[*].merge(@, {\n    created: @.\"Created Date\",\n    modified: @.\"Modified Date\",\n    artwork: @.\"Cover Photo\"\n})",
            "blockComment": "\u2728 Standardise field names"
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, {\n    created: formatDate(created, 'yyyy/MM/dd, T'),\n    modified: formatDate(modified, 'yyyy/MM/dd, T')\n})",
            "blockComment": "\ud83d\udcc5 Format date fields for display"
        },
        {
            "type": "mapping",
            "mapping": "context.hideBlanks && data[?ISRC != null] || data",
            "blockComment": "\ud83d\uddd1\ufe0f Filter out blank ISRCs if toggled"
        },
        {
            "type": "grid",
            "gridOptions": {
                "rowSelection": "multiple",
                "rowMultiSelectWithClick": true,
                "pagination": true,
                "paginationPageSize": 20,
                "defaultColDef": {
                    "autoHeight": true,
                    "resizable": true,
                    "sortable": true
                }
            },
            "passThrough": false,
            "firstRowHeaders": false,
            "columnDefs": [
                {
                    "headerCheckboxSelection": true,
                    "checkboxSelection": true,
                    "width": 70,
                    "suppressSizeToFit": true
                },
                {
                    "field": "artwork",
                    "headerName": "Artwork",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "template",
                                "template": "<img width='150' height='150' src='{{data.artwork}}' />"
                            }
                        ]
                    }
                },
                {
                    "field": "Artist",
                    "headerName": "Artist"
                },
                {
                    "field": "Name",
                    "headerName": "Title"
                },
                {
                    "field": "created",
                    "headerName": "Created"
                },
                {
                    "field": "modified",
                    "headerName": "Modified"
                },
                {
                    "field": "ISRC",
                    "headerName": "ISRC",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "message",
                                "message": "{{data.ISRC}}"
                            }
                        ]
                    }
                },
                {
                    "field": "Details",
                    "headerName": "",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "mapping",
                                "mapping": "data.ISRC"
                            },
                            {
                                "type": "switch",
                                "valueGetter": "data",
                                "cases": [
                                    {
                                        "value": null,
                                        "blocks": []
                                    }
                                ],
                                "default": {
                                    "blocks": [
                                        {
                                            "type": "actions",
                                            "buttons": [
                                                {
                                                    "label": "Details",
                                                    "color": "primary",
                                                    "blocks": [
                                                        {
                                                            "type": "variable-set",
                                                            "name": "isrc"
                                                        },
                                                        {
                                                            "type": "launch",
                                                            "adapter": "freecords",
                                                            "workflowId": "getsongdetails"
                                                        }
                                                    ],
                                                    "enabled": true
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ],
            "blockComment": "\ud83d\udcca Display songs in data grid"
        },
        {
            "type": "mapping",
            "mapping": "data[?ISRC != '']",
            "blockComment": "\ud83d\udd0e Filter selection for valid ISRCs"
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Prepare upload Selection for later automatic upload on completion",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "context",
                                    "contextPath": "song",
                                    "contextBlocks": [
                                        {
                                            "type": "context-save",
                                            "key": "song"
                                        }
                                    ],
                                    "blocks": [
                                        {
                                            "type": "switch",
                                            "valueGetter": "data.ISRC",
                                            "cases": [
                                                {
                                                    "value": null,
                                                    "blocks": [
                                                        {
                                                            "type": "debug",
                                                            "consoleLabel": "ISRC Missing",
                                                            "consoleLog": true,
                                                            "blockComment": "Case for when ISRC is null - this logic will not run."
                                                        }
                                                    ]
                                                }
                                            ],
                                            "default": {
                                                "blocks": [
                                                    {
                                                        "type": "context",
                                                        "contextPath": "requestData",
                                                        "contextBlocks": [
                                                            {
                                                                "type": "mapping",
                                                                "mapping": "{api_token: context.api.key, ISRC: data.ISRC}"
                                                            }
                                                        ],
                                                        "blocks": [
                                                            {
                                                                "type": "http",
                                                                "method": "get",
                                                                "useProxy": true,
                                                                "endpoint": {
                                                                    "protocol": "https:",
                                                                    "host": "app.freecords.com/api/v1.1/wf",
                                                                    "pathname": "/get_song",
                                                                    "valueGetters": {
                                                                        "query": "context.requestData"
                                                                    }
                                                                },
                                                                "blockComment": "This HTTP block now safely uses the data prepared in the context above."
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": "\ud83d\udce4 Define 'Upload Selection' button and prep logic"
        }
    ],
    "id": "dashboardracefix6Nested",
    "workflowId": "dashboardracefix6Nested",
    "adapterName": "freecords",
    "created": "2025-10-23T16:11:07.772Z",
    "tags": [],
    "updated": "2025-10-23T16:11:07.770Z",
    "modified": "2025-10-23T16:11:07.770Z",
    "title": "Freecords Dashboard"
}