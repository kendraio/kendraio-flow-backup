{
    "blocks": [
        {
            "type": "message",
            "message": "Don't forget to log in and run this Flow on https://kendraio-app-git-http-block-aws-signed-authenti-a8a3cb-kendraio.vercel.app",
            "blockComment": ""
        },
        {
            "type": "gosub",
            "adapterName": "freecords",
            "workflowId": "batchnameform",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "{ hideBlanks: true }",
            "blockComment": ""
        },
        {
            "type": "form",
            "hasSubmit": false,
            "emitOnInit": true,
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "hideBlanks": {
                        "type": "boolean",
                        "title": "Hide blank ISRCs",
                        "default": true
                    }
                }
            },
            "uiSchema": {},
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.hideBlanks",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "hideBlanks",
            "blockComment": ""
        },
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "freecords",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "api",
            "blockComment": ""
        },
        {
            "type": "http",
            "method": "get",
            "useProxy": true,
            "endpoint": {
                "protocol": "https:",
                "host": "freecords.bubbleapps.io/version-test/api/1.1",
                "pathname": "/obj/song"
            },
            "headers": {
                "authorization": "join('', ['Bearer ', data.key])"
            },
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.data.response.results[*].merge(@, {\n    created: @.\"Created Date\",\n    modified: @.\"Modified Date\",\n    artwork: @.\"Cover Photo\"\n})",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, {\n    created: formatDate(created, 'yyyy/MM/dd, T'),\n    modified: formatDate(modified, 'yyyy/MM/dd, T')\n})",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "context.hideBlanks && data[?ISRC != null] || data",
            "blockComment": ""
        },
        {
            "type": "grid",
            "gridOptions": {
                "rowSelection": "multiple",
                "rowMultiSelectWithClick": true,
                "pagination": true,
                "paginationPageSize": 20,
                "defaultColDef": {
                    "autoHeight": true,
                    "resizable": true,
                    "sortable": true
                }
            },
            "passThrough": false,
            "firstRowHeaders": false,
            "columnDefs": [
                {
                    "headerCheckboxSelection": true,
                    "checkboxSelection": true,
                    "width": 70,
                    "suppressSizeToFit": true
                },
                {
                    "field": "artwork",
                    "headerName": "Artwork",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "template",
                                "template": "<img width='150' height='150' src='{{data.artwork}}' />"
                            }
                        ]
                    }
                },
                {
                    "field": "Artist",
                    "headerName": "Artist"
                },
                {
                    "field": "Name",
                    "headerName": "Title"
                },
                {
                    "field": "created",
                    "headerName": "Created"
                },
                {
                    "field": "modified",
                    "headerName": "Modified"
                },
                {
                    "field": "ISRC",
                    "headerName": "ISRC",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "message",
                                "message": "{{data.ISRC}}"
                            }
                        ]
                    }
                },
                {
                    "field": "Details",
                    "headerName": "",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "mapping",
                                "mapping": "data.ISRC"
                            },
                            {
                                "type": "switch",
                                "valueGetter": "data",
                                "cases": [
                                    {
                                        "value": null,
                                        "blocks": []
                                    }
                                ],
                                "default": {
                                    "blocks": [
                                        {
                                            "type": "actions",
                                            "buttons": [
                                                {
                                                    "label": "Details",
                                                    "color": "primary",
                                                    "blocks": [
                                                        {
                                                            "type": "variable-set",
                                                            "name": "isrc"
                                                        },
                                                        {
                                                            "type": "launch",
                                                            "adapter": "freecords",
                                                            "workflowId": "getsongdetails"
                                                        }
                                                    ],
                                                    "enabled": true
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data[?ISRC != \"\"]",
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Add to Backblaze",
                    "color": "primary",
                    "enabledGetter": "data[0]",
                    "blocks": [
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "gosub",
                                    "adapterName": "freecords",
                                    "workflowId": "addonetobackblazecontexts"
                                }
                            ]
                        }
                    ],
                    "enabled": null
                },
                {
                    "label": "Verify",
                    "color": "primary",
                    "enabledGetter": "data[0]",
                    "blocks": [
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "context",
                                    "contextPath": "song",
                                    "contextBlocks": [
                                        {
                                            "type": "context-save",
                                            "key": "song"
                                        }
                                    ],
                                    "blocks": [
                                        {
                                            "type": "mapping",
                                            "mapping": "{ISRC: context.song.ISRC}"
                                        },
                                        {
                                            "type": "http",
                                            "method": "post",
                                            "useProxy": false,
                                            "endpoint": {
                                                "protocol": "https:",
                                                "host": "app.freecords.com/api/1.1/wf",
                                                "pathname": "/get_song",
                                                "valueGetters": {
                                                    "query": "{api_token: context.api.key}"
                                                }
                                            }
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "data.data.response.merge(@, {artistName: @.\"artist-name\"})"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "details"
                                        },
                                        {
                                            "type": "http",
                                            "method": "get",
                                            "useProxy": true,
                                            "endpoint": {
                                                "valueGetter": "context.song.artwork"
                                            },
                                            "responseType": "arraybuffer",
                                            "headers": {}
                                        },
                                        {
                                            "type": "debug",
                                            "consoleLog": true
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "imageSourceResponse"
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "join('', [`https://freecords.s3.eu-central-003.backblazeb2.com/`, context.details.UPC, '/', context.song.ISRC, '.jpg'])"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "imageBackblazeEndpoint"
                                        },
                                        {
                                            "type": "http",
                                            "method": "get",
                                            "useProxy": true,
                                            "endpoint": {
                                                "valueGetter": "context.imageBackblazeEndpoint"
                                            },
                                            "authentication": {
                                                "type": "aws-sigv4",
                                                "secretKeyGetter": "context.api.secretKey",
                                                "accessKeyIdGetter": "context.api.accessKeyId"
                                            },
                                            "responseType": "arraybuffer",
                                            "headers": {}
                                        },
                                        {
                                            "type": "debug",
                                            "consoleLog": true
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "data.merge(@, { sourceHash: $.context.imageSourceResponse.responseHash, ISRC: $.context.song.ISRC, endpoint: $.context.imageBackblazeEndpoint, UPC: $.context.details.UPC, source: $.context.song.artwork, artwork: $.context.song.artwork, title: $.context.song.Name, artist: $.context.details.artistName, type: 'Image' })"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "imageStatus"
                                        },
                                        {
                                            "type": "http",
                                            "method": "get",
                                            "useProxy": true,
                                            "endpoint": {
                                                "valueGetter": "context.song.AAC"
                                            },
                                            "responseType": "arraybuffer",
                                            "headers": {}
                                        },
                                        {
                                            "type": "debug",
                                            "consoleLog": true
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "audioSourceResponse"
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "join('', [`https://freecords.s3.eu-central-003.backblazeb2.com/`, context.details.UPC, '/', context.song.ISRC, '.wav'])"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "wavBackblazeEndpoint"
                                        },
                                        {
                                            "type": "http",
                                            "method": "get",
                                            "useProxy": true,
                                            "endpoint": {
                                                "valueGetter": "context.wavBackblazeEndpoint"
                                            },
                                            "authentication": {
                                                "type": "aws-sigv4",
                                                "secretKeyGetter": "context.api.secretKey",
                                                "accessKeyIdGetter": "context.api.accessKeyId"
                                            },
                                            "responseType": "arraybuffer",
                                            "headers": {}
                                        },
                                        {
                                            "type": "debug",
                                            "consoleLog": true
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "data.merge(@, { sourceHash: $.context.audioSourceResponse.responseHash, ISRC: $.context.song.ISRC, endpoint: $.context.wavBackblazeEndpoint, UPC: $.context.details.UPC, source: $.context.song.AAC, artwork: $.context.song.artwork, title: $.context.song.Name, artist: $.context.details.artistName, type: 'Audio' })"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "wavStatus"
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "join('', [`https://freecords.s3.eu-central-003.backblazeb2.com/`, context.details.UPC, '/', context.details.UPC, '.xml'])"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "ddexBackblazeEndpoint"
                                        },
                                        {
                                            "type": "http",
                                            "method": "get",
                                            "useProxy": true,
                                            "endpoint": {
                                                "valueGetter": "context.ddexBackblazeEndpoint"
                                            },
                                            "authentication": {
                                                "type": "aws-sigv4",
                                                "secretKeyGetter": "context.api.secretKey",
                                                "accessKeyIdGetter": "context.api.accessKeyId"
                                            }
                                        },
                                        {
                                            "type": "debug",
                                            "consoleLog": true
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "data.merge(@, { sourceHash: 'N/A', ISRC: $.context.song.ISRC, endpoint: $.context.ddexBackblazeEndpoint, UPC: $.context.details.UPC, source: $.context.ddexBackblazeEndpoint, artwork: $.context.song.artwork, title: $.context.song.Name, artist: $.context.details.artistName, type: 'Metadata', bucketContents: data.error.error.text })"
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "[context.imageStatus, context.wavStatus, [data]][]"
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "enabled": null
                }
            ],
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data[]",
            "blockComment": ""
        },
