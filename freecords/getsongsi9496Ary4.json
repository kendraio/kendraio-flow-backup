            "blockComment": ""
        },
        {
            "type": "http",
            "method": "get",
            "useProxy": true,
            "endpoint": {
                "protocol": "https:",
                "host": "freecords.bubbleapps.io/version-test/api/1.1",
                "pathname": "/obj/song"
            },
            "headers": {
                "authorization": "join('', ['Bearer ', data.key])",
                "cursor": "'1'",
                "limit": "'10'"
            },
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "mapping",
            "mapping": "data.response.results[*].merge(@, {\n    created: @.\"Created Date\",\n    modified: @.\"Modified Date\",\n    artwork: @.\"Cover Photo\"\n})",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, {\n    created: formatDate(created, 'yyyy/MM/dd, T'),\n    modified: formatDate(modified, 'yyyy/MM/dd, T')\n})",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "context.hideBlanks && data[?ISRC != null] || data",
            "blockComment": ""
        },
        {
            "type": "grid",
            "gridOptions": {
                "rowSelection": "multiple",
                "rowMultiSelectWithClick": true,
                "pagination": true,
                "paginationPageSize": 20,
                "defaultColDef": {
                    "autoHeight": true,
                    "resizable": true,
                    "sortable": true
                }
            },
            "passThrough": false,
            "firstRowHeaders": false,
            "columnDefs": [
                {
                    "headerCheckboxSelection": true,
                    "checkboxSelection": true,
                    "width": 70,
                    "suppressSizeToFit": true
                },
                {
                    "field": "artwork",
                    "headerName": "Artwork",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "template",
                                "template": "<img width='150' height='150' src='{{data.artwork}}' />"
                            }
                        ]
                    }
                },
                {
                    "field": "Artist",
                    "headerName": "Artist"
                },
                {
                    "field": "Name",
                    "headerName": "Title"
                },
                {
                    "field": "created",
                    "headerName": "Created"
                },
                {
                    "field": "modified",
                    "headerName": "Modified"
                },
                {
                    "field": "ISRC",
                    "headerName": "ISRC",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "message",
                                "message": "{{data.ISRC}}"
                            }
                        ]
                    }
                },
                {
                    "field": "Details",
                    "headerName": "",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "mapping",
                                "mapping": "data.ISRC"
                            },
                            {
                                "type": "switch",
                                "valueGetter": "data",
                                "cases": [
                                    {
                                        "value": null,
                                        "blocks": []
                                    }
                                ],
                                "default": {
                                    "blocks": [
                                        {
                                            "type": "actions",
                                            "buttons": [
                                                {
                                                    "label": "Details",
                                                    "color": "primary",
                                                    "blocks": [
                                                        {
                                                            "type": "variable-set",
                                                            "name": "isrc"
                                                        },
                                                        {
                                                            "type": "launch",
                                                            "adapter": "freecords",
                                                            "workflowId": "getsongdetails"
                                                        }
                                                    ],
                                                    "enabled": true
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ],
            "blockComment": ""
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Add to Backblaze",
                    "color": "primary",
                    "enabledGetter": "data[0]",
                    "blocks": [
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "gosub",
                                    "adapterName": "freecords",
                                    "workflowId": "addonetobackblazei9496Ary4"
                                }
                            ]
                        }
                    ],
                    "enabled": null
                },
                {
                    "label": "Verify",
                    "color": "primary",
                    "enabledGetter": "data[0]",
                    "blocks": [
                        {
                            "type": "batch",
                            "blocks": [
                                {
                                    "type": "context",
                                    "contextPath": "song",
                                    "contextBlocks": [
                                        {
                                            "type": "context-save",
                                            "key": "song"
                                        }
                                    ],
                                    "blocks": [
                                        {
                                            "type": "mapping",
                                            "mapping": "{ISRC: context.song.ISRC}"
                                        },
                                        {
                                            "type": "http",
                                            "method": "post",
                                            "useProxy": false,
                                            "endpoint": {
                                                "protocol": "https:",
                                                "host": "app.freecords.com/api/1.1/wf",
                                                "pathname": "/get_song",
                                                "valueGetters": {
                                                    "query": "{api_token: context.api.key}"
                                                }
                                            }
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "data.response.UPC"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "UPC"
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "join('', [`https://freecords.s3.eu-central-003.backblazeb2.com/`, context.UPC, '/', context.song.ISRC, '.wav', '?acl=null'])"
                                        },
                                        {
                                            "type": "context-save",
                                            "key": "wavBackblazeEndpoint"
                                        },
                                        {
                                            "type": "http",
                                            "method": "get",
                                            "useProxy": true,
                                            "endpoint": {
                                                "valueGetter": "context.wavBackblazeEndpoint"
                                            },
                                            "authentication": {
                                                "type": "aws-sigv4",
                                                "secretKeyGetter": "context.api.secretKey",
                                                "accessKeyIdGetter": "context.api.accessKeyId"
                                            }
                                        },
                                        {
                                            "type": "mapping",
                                            "mapping": "data.merge(@, { ISRC: $.context.song.ISRC, endpoint: $.context.wavBackblazeEndpoint, UPC: $.context.UPC })"
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "enabled": null
                }
            ],
            "blockComment": ""
        },
