        {
            "type": "context-save",
            "key": "hideBlanks",
            "blockComment": ""
        },
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "freecords",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "api",
            "blockComment": ""
        },
        {
            "type": "http",
            "method": "get",
            "useProxy": true,
            "endpoint": {
                "protocol": "https:",
                "host": "freecords.bubbleapps.io/version-test/api/1.1",
                "pathname": "/obj/song"
            },
            "headers": {
                "authorization": "join('', ['Bearer ', data.key])"
            },
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.response.results[*].merge(@, {\n    created: @.\"Created Date\",\n    modified: @.\"Modified Date\",\n    artwork: @.\"Cover Photo\"\n})",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, {\n    created: formatDate(created, 'yyyy/MM/dd, T'),\n    modified: formatDate(modified, 'yyyy/MM/dd, T')\n})",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "context.hideBlanks && data[?ISRC != null] || data",
            "blockComment": ""
        },
        {
            "type": "grid",
            "gridOptions": {
                "rowSelection": "multiple",
                "rowMultiSelectWithClick": true,
                "pagination": true,
                "paginationPageSize": 10,
                "defaultColDef": {
                    "autoHeight": true,
                    "resizable": true,
                    "sortable": true
                }
            },
            "passThrough": false,
            "firstRowHeaders": false,
            "columnDefs": [
                {
                    "headerCheckboxSelection": true,
                    "checkboxSelection": true,
                    "width": 70,
                    "suppressSizeToFit": true
                },
                {
                    "field": "artwork",
                    "headerName": "Artwork",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "template",
                                "template": "<img width='150' height='150' src='{{data.artwork}}' />"
                            }
                        ]
                    }
                },
                {
                    "field": "Artist",
                    "headerName": "Artist"
                },
                {
                    "field": "Name",
                    "headerName": "Title"
                },
                {
                    "field": "created",
                    "headerName": "Created"
                },
                {
                    "field": "modified",
                    "headerName": "Modified"
                },
                {
                    "field": "ISRC",
                    "headerName": "ISRC",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "message",
                                "message": "{{data.ISRC}}"
                            }
                        ]
                    }
                },
                {
                    "field": "Details",
                    "headerName": "",
                    "cellRenderer": "workflowRenderer",
                    "cellRendererParams": {
                        "blocks": [
                            {
                                "type": "mapping",
                                "mapping": "data.ISRC"
                            },
                            {
                                "type": "switch",
                                "valueGetter": "data",
                                "cases": [
                                    {
                                        "value": null,
                                        "blocks": []
                                    }
                                ],
                                "default": {
                                    "blocks": [
                                        {
                                            "type": "actions",
                                            "buttons": [
                                                {
                                                    "label": "Details",
                                                    "color": "primary",
                                                    "blocks": [
                                                        {
                                                            "type": "variable-set",
                                                            "name": "isrc"
                                                        },
                                                        {
                                                            "type": "launch",
                                                            "adapter": "freecords",
                                                            "workflowId": "getsong"
                                                        }
                                                    ],
                                                    "enabled": true
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ],
            "blockComment": ""
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Get Details",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "gosub",
                            "adapterName": "freecords",
                            "workflowId": "getdetailsbatch"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": false,
            "showState": false
        },
        {
            "type": "context-save",
            "key": "state.selections",
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "{     data: {        NewReleaseMessage: {            PartyList: {                Party: [                    {                        PartyReference: PartyReference,                        PartyName: [                            {                                FullName: FullName,                                FullNameIndexed: FullNameIndexed,                                _LanguageAndScriptCode: _LanguageAndScriptCode                            }                        ]                    }                            ]            },            ResourceList: {                SoundRecording: data[*].merge(@, {                    ResourceReference: `A1`,                    Contributor: {                        ContributorPartyReference:  Contributor.PartyReference,                        Role: Contributor.Role,                        _SequenceNumber: Contributor._SequenceNumber                    },                    CreationDate: {                        __text: CreationDate.__text,                                                        _IsApproximate: CreationDate._IsApproximate                    },                    ResourceId: {                        ISRC: isrc                    },                    DisplayTitleText: \"song-name\",                    DisplayTitle: [                        {                            TitleText: DisplayTitle.TitleText,                            _ApplicableTerritoryCode: DisplayTitle._ApplicableTerritoryCode,                            _IsDefault: DisplayTitle._IsDefault                        }                    ],                    LanguageOfPerformance: LanguageOfPerformance,                    Duration:  duration,                    IsInstrumental: IsInstrumental,                    PLine: {                        PLineText: PLine.Text                    }                })            },            \"_xmlns:avs\":               `http://ddex.net/xml/avs/avs`,            \"_xmlns:ern\":               `http://ddex.net/xml/ern/42`,            \"_xmlns:xsi\":               `http://www.w3.org/2001/XMLSchema-instance`,            \"_xsi:schemaLocation\":      `http://ddex.net/xml/ern/42 http://ddex.net/xml/ern/42/release-notification.xsd`,            _ReleaseProfileVersionId: `Audio`,            LanguageAndScriptCode:    `en`,            __prefix:                 `ern`        }    },    created: now(),    batchName: state.local.batchName || `Freecords`}",
            "blockComment": ""
        },
        {
