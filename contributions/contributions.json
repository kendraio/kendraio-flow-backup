{
    "blocks": [
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Add a new contributions",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "launch",
                            "adapter": "contributions",
                            "workflowId": "contributions-add"
                        }
                    ],
                    "enabled": true
