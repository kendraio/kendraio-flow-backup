        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "contributionsAuth",
            "blockComment": "contributionsAuth"
        },
        {
            "type": "context-save",
            "key": "contributionsAuth",
            "blockComment": ""
        },
        {
            "type": "template",
            "template": "<b>If you don't see any data, please <a href='/connect'>autheticate</a></b><br>",
            "blockComment": ""
        },
        {
            "type": "http",
            "method": "get",
            "endpoint": {
                "protocol": "https:",
                "host": "api.baserow.io/api/database",
                "query": {
                    "user_field_names": "true"
                },
                "valueGetters": {
                    "pathname": "data.contributionsPathname"
                }
            },
            "headers": {
                "Content-Type": "'application/json'",
                "Authorization": "data.apikey"
            },
            "useProxy": true,
            "onError": {
                "blocks": [
                    {
                        "type": "card",
                        "blocks": [
                            {
                                "type": "template",
                                "template": "Error with submission:<p>{{data.errorMessage}}</p>"
                            }
                        ]
                    }
                ]
            },
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.results[*].omit(@, ['order']).merge(@, {\"idString\": to_string(id)} )\n",
            "blockComment": "Omit and add isString"
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, \n    {\n        \"apikey\": $.context.contributionsAuth.apikey,\n        \"contributionsPathnameId\": join('', [$.context.contributionsAuth.contributionsPathname, @.idString, '/'])\n    }\n)",
            "blockComment": "add path for http request"
        },
