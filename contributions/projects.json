                    "user_field_names": "true"
                },
                "valueGetters": {
                    "pathname": "data.projectsPathname"
                }
            },
            "headers": {
                "Content-Type": "'application/json'",
                "Authorization": "data.apikey"
            },
            "useProxy": true,
            "onError": {
                "blocks": [
                    {
                        "type": "card",
                        "blocks": [
                            {
                                "type": "template",
                                "template": "Error with submission:<p>{{data.errorMessage}}</p>"
                            }
                        ]
                    }
                ]
            },
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data.results[*].omit(@, ['order']).merge(@, {\"idString\": to_string(id)} )\n",
            "blockComment": "omit order + idString"
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, \n    {\n        \"apikey\": $.context.contributionsAuth.apikey,\n        \"projectsPathnameId\": join('', [$.context.contributionsAuth.projectsPathname, @.idString, '/'])\n    }\n)",
            "blockComment": "add path for http request"
        },
