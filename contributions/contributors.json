        {
            "type": "mapping",
            "mapping": "data.results[*].omit(@, ['order']).merge(@, {\"idString\": to_string(id)} )",
            "blockComment": "omit order + idString"
        },
        {
            "type": "mapping",
            "mapping": "data[*].merge(@, \n    {\n        \"apikey\": $.context.contributionsAuth.apikey,\n        \"contributorsPathnameId\": join('', [$.context.contributionsAuth.contributorsPathname, @.idString, '/'])\n    }\n)",
            "blockComment": "add path for http request"
