{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "mapping",
            "mapping": "{\n    \"idString\": context.queryParams.id || `\"\"`,\n    \"id\": to_number(context.queryParams.id),\n    \"Contributor\": context.queryParams.Contributor,\n    \"Notes\": context.queryParams.Notes\n}",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "key": "contributor",
            "blockComment": ""
        },
        {
            "type": "variable-get",
            "name": "contributionsAuth",
            "blockComment": ""
        },
        {
            "type": "debug",
            "open": 1,
            "showData": true,
            "showContext": true,
            "showState": false,
            "blockComment": ""
        },
        {
            "type": "mapping",
            "mapping": "data && data.merge(@, {\n    \"contributorsPathnameId\": join('', [@.contributorsPathname, $.context.contributor.idString])\n})",
            "blockComment": ""
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Add",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "launch",
                            "adapter": "contributions",
                            "workflowId": "contributor-add"
                        }
                    ],
                    "enabled": true
                },
                {
                    "label": "Edit",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "launch",
                            "adapter": "contributions",
                            "workflowId": "contributors-edit-record",
                            "context": {
                                "id": "context.contributor.id",
                                "contributor": "context.contributor.Contributor",
                                "notes": "context.contributor.Notes",
                                "active": "context.contributor.Active"
                            }
                        }
                    ],
                    "enabled": true
                },
                {
                    "label": "Delete",
                    "color": "warn",
                    "blocks": [
                        {
                            "type": "dialog",
                            "blocks": [
                                {
                                    "type": "message",
                                    "title": "Are you sure you want to delete this contributor?",
                                    "message": "This action will permanently delete this contributor form the common database."
                                },
                                {
                                    "type": "actions",
                                    "buttons": [
                                        {
                                            "label": "Delete",
                                            "color": "warn",
                                            "blocks": [
                                                {
                                                    "type": "http",
                                                    "method": "post",
                                                    "endpoint": {
                                                        "protocol": "https:",
                                                        "host": "api.baserow.io/api/database",
                                                        "query": {
                                                            "user_field_names": "true"
                                                        },
                                                        "valueGetters": {
                                                            "pathname": "data.contributorsPathnameId"
                                                        }
                                                    },
                                                    "headers": {
                                                        "Content-Type": "'application/json'",
                                                        "Authorization": "data.apikey"
                                                    },
                                                    "useProxy": true,
                                                    "onError": {
                                                        "blocks": [
                                                            {
                                                                "type": "card",
                                                                "blocks": [
                                                                    {
                                                                        "type": "template",
                                                                        "template": "Error with submission:<p>{{data.errorMessage}}</p>"
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                }
                                            ],
                                            "enabled": true
                                        },
                                        {
                                            "label": "Cancel Action",
                                            "blocks": [
                                                {
                                                    "type": "init"
                                                }
                                            ],
                                            "enabled": true
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": ""
        }
    ],
