{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "template",
            "template": "Statistics of tracks played from Distributor and Audiotarky on our player Flow are combined together here using track metadata from both services. Below we gather the data and explain how it works. Going through how the data is combined step by step. For a <a href='https://app.kendra.io/player/stats'>more minimal presentation of the stats see here</a>.",
            "blockComment": ""
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Load stats",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "graphql",
                            "endpoint": "https://kendraio-distributor.hasura.app/v1/graphql",
                            "query": "query {\n  generic_xrp_rank {\n    analyticsItemUUID\n    total_xrp\n    sessions\n    total_session_mins\n  }\n}",
                            "variables": {},
                            "headers": {},
                            "allowFirst": true,
                            "allowEmpty": true
                        },
                        {
                            "type": "validator",
                            "test": "not_null(data)",
                            "message": "Loading"
                        },
                        {
                            "type": "mapping",
                            "mapping": "data.data.generic_xrp_rank[].{ id:analyticsItemUUID, xrp:total_xrp, sessions:sessions, total_session_mins:total_session_mins}"
                        },
                        {
                            "type": "variable-set",
                            "name": "graphqlGenericXrp"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": "Fetch generic_xrp_rank, save as var"
        },
        {
            "type": "template",
            "template": "Raw stats data:"
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Load tracks",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "graphql",
                            "endpoint": "https://kendraio-distributor.hasura.app/v1/graphql",
                            "query": "query {\n  tracks {\n    display_artist\n    display_title\n    id\n  }\n}",
                            "variables": {},
                            "headers": {},
                            "allowFirst": true,
                            "allowEmpty": true
                        },
                        {
                            "type": "validator",
                            "test": "not_null(data)",
                            "message": "Loading"
                        },
                        {
                            "type": "mapping",
                            "mapping": "data.data.tracks[].{ id:id, title:display_title, artist:display_artist }"
                        },
                        {
                            "type": "variable-set",
                            "name": "graphqlTracks"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": "fetch tracks, , save as var"
        },
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "graphqlGenericXrp",
            "blockComment": "graphqlGenericXrp"
        },
        {
            "type": "context-save",
            "key": "stats",
            "blockComment": "stats"
        },
        {
            "type": "variable-get",
            "name": "graphqlTracks",
            "blockComment": "graphqlTracks"
        },
        {
            "type": "context-save",
            "key": "dsp1",
            "blockComment": "dsp1"
        },
        {
            "type": "template",
            "template": "Downloads Distributor metadata and make it the same format:",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "contextKey": "dsp1"
        },
        {
            "type": "http",
            "method": "get",
            "endpoint": {
                "protocol": "https://",
                "host": "www.audiotarky.com",
                "pathname": "/api/tracks/index.json"
            }
        },
        {
            "type": "validator",
            "test": "not_null(data.tracks)",
            "message": "Loading"
        },
        {
            "type": "template",
            "template": "Downloads Audiotarky track metadata, and make it the same format with UUID hashes based on the track URL:"
        },
        {
            "type": "mapping",
            "mapping": "context.dsp1[].{id: uuid(url), title:name, artist:artist} ",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "contextKey": "at_id"
        },
        {
            "type": "mapping",
            "mapping": "[context.at_id,context.dsp1][].[id, { title:title, artist:artist, id:id}].fromPairs(@)",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "contextKey": "comb"
        },
        {
            "type": "mapping",
            "mapping": "[context.stats][].[id,{ xrp:xrp, id:id, sessions:sessions,total_session_mins:total_session_mins}].fromPairs(@)",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "contextKey": "stats_index"
        },
        {
            "type": "template",
            "template": "Improve statistics using the combined track metadata:"
        },
        {
            "type": "mapping",
            "mapping": "context.stats[].id| [*].{id: @, title: get($.context.comb,@).title, artist: get($.context.comb,@).artist, xrp: get($.context.stats_index,@).xrp, sessions: get($.context.stats_index,@).sessions, total_session_mins:get($.context.stats_index,@).total_session_mins}",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "contextKey": "all_comb"
        },
        {
            "type": "validator",
            "test": "not_null(context.all_comb[].{ label: title, value: xrp })",
            "message": "Loading"
        },
        {
            "type": "multi",
            "batches": [
                {
                    "blocks": [
                        {
                            "type": "grid",
                            "gridOptions": {},
                            "columnDefs": [
                                {
                                    "headerName": "Artist",
                                    "field": "artist"
                                },
                                {
                                    "headerName": "Title",
                                    "field": "title"
                                },
                                {
                                    "headerName": "Total XRP",
                                    "field": "xrp"
                                },
                                {
                                    "headerName": "Sessions",
                                    "field": "sessions"
                                },
                                {
                                    "headerName": "Total Session Minutes",
                                    "field": "total_session_mins"
                                }
                            ]
                        }
                    ]
                },
                {
                    "blocks": [
                        {
                            "type": "mapping",
                            "mapping": "context.all_comb[].{ label: title, value: xrp }"
                        },
                        {
                            "type": "chart"
                        }
                    ]
                }
            ]
        }
    ],
    "id": "statsComb",
    "workflowId": "statsComb",
    "adapterName": "player",
    "created": "2026-01-28T18:46:47.001Z",
    "tags": [],
    "updated": "2026-01-28T18:46:47.001Z",
    "modified": "2026-01-28T18:46:47.001Z",
    "title": "Kendraio Player Statistics"
}