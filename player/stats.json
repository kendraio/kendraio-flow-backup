{
    "blocks": [
        {
            "type": "init"
        },
        {
            "type": "template",
            "template": "Statistics of tracks played from Distributor and Audiotarky on our player Flow are combined together here using track metadata from both services. To see <a href='https://app.kendra.io/player/statsComb'> more about how it works, here is a version of this flow, with comments</a>, going through how the data is combined step by step.",
            "blockComment": ""
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Load Distributor stats",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "graphql",
                            "endpoint": "https://kendraio-distributor.hasura.app/v1/graphql",
                            "query": "query {\n  generic_xrp_rank {\n    analyticsItemUUID\n    total_xrp\n    sessions\n    total_session_mins\n  }\n}",
                            "variables": {},
                            "headers": {},
                            "allowFirst": true,
                            "allowEmpty": true
                        },
                        {
                            "type": "validator",
                            "test": "not_null(data)",
                            "message": "Loading"
                        },
                        {
                            "type": "mapping",
                            "mapping": "data.data.generic_xrp_rank[].{ id:analyticsItemUUID, xrp:total_xrp, sessions:sessions, total_session_mins:total_session_mins}"
                        },
                        {
                            "type": "variable-set",
                            "name": "graphqlGenericXrp"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": "Fetch generic_xrp_rank, map and save in context on button trigger"
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "label": "Load Distributor track metadata",
                    "color": "primary",
                    "blocks": [
                        {
                            "type": "graphql",
                            "endpoint": "https://kendraio-distributor.hasura.app/v1/graphql",
                            "query": "query { tracks { display_artist display_title id } }",
                            "variables": {},
                            "headers": {},
                            "allowFirst": true,
                            "allowEmpty": true
                        },
                        {
                            "type": "validator",
                            "test": "not_null(data)",
                            "message": "Loading"
                        },
                        {
                            "type": "mapping",
                            "mapping": "data.data.tracks[].{ id:id, title:display_title, artist:display_artist }"
                        },
                        {
                            "type": "variable-set",
                            "name": "graphqlTracks"
                        }
                    ],
                    "enabled": true
                }
            ],
            "blockComment": "Fetch tracks, map and save in context on button trigger"
        },
        {
            "type": "init"
        },
        {
            "type": "variable-get",
            "name": "graphqlGenericXrp",
            "blockComment": "graphqlGenericXrp"
        },
        {
            "type": "context-save",
            "key": "stats",
            "blockComment": "stats"
        },
        {
            "type": "variable-get",
            "name": "graphqlTracks",
            "blockComment": "graphqlTracks"
        },
        {
            "type": "context-save",
            "key": "tracks",
            "blockComment": "tracks"
        },
        {
            "type": "http",
            "method": "get",
            "endpoint": {
                "protocol": "https://",
                "host": "www.audiotarky.com",
                "pathname": "/api/tracks/index.json"
            },
            "blockComment": ""
        },
        {
            "type": "validator",
            "test": "not_null(data.tracks)",
            "message": "Loading"
        },
        {
            "type": "mapping",
            "mapping": "context.tracks[].{\n    id: uuid(url),\n    title:name,\n    artist:artist\n} ",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "contextKey": "at_id",
            "blockComment": "at_id"
        },
        {
            "type": "mapping",
            "mapping": "[context.at_id,context.tracks][].[\n\t\t\tid, \n\t\t\t{\n                title:title, \n                artist:artist, \n                id:id\n            }\n\t\t].fromPairs(@)",
            "blockComment": ""
        },
        {
            "type": "context-save",
            "contextKey": "comb",
            "blockComment": "comb"
        },
        {
            "type": "mapping",
            "mapping": "[context.stats][].[\n\t\t\tid, \n\t\t\t{\n               xrp:xrp\n                id:id,\n                sessions:sessions,\n                total_session_mins:total_session_mins\n            }\n\t\t].fromPairs(@)"
        },
        {
            "type": "context-save",
            "contextKey": "stats_index",
            "blockComment": "stats_index"
        },
        {
            "type": "mapping",
            "mapping": "context.stats[].id| [*].{\n    id: @, \n    title: get($.context.comb,@).title,\n    artist: get($.context.comb,@).artist,\n    xrp: get($.context.stats_index,@).xrp,\n    sessions: get($.context.stats_index,@).sessions\n    total_session_mins:get($.context.stats_index,@).total_session_mins\n    }\n    "
        },
        {
            "type": "context-save",
            "contextKey": "all_comb",
            "blockComment": "all_comb"
        },
        {
            "type": "validator",
            "test": "not_null(context.all_comb[].{ label: title, value: xrp })",
            "message": "Loading"
        },
        {
            "type": "multi",
            "batches": [
                {
                    "blocks": [
                        {
                            "type": "grid",
                            "gridOptions": {},
                            "columnDefs": [
                                {
                                    "headerName": "Artist",
                                    "field": "artist"
                                },
                                {
                                    "headerName": "Title",
                                    "field": "title"
                                },
                                {
                                    "headerName": "Total XRP",
                                    "field": "xrp"
                                },
                                {
                                    "headerName": "Sessions",
                                    "field": "sessions"
                                },
                                {
                                    "headerName": "Total Session Minutes",
                                    "field": "total_session_mins"
                                }
                            ]
                        }
                    ]
                },
                {
                    "blocks": [
                        {
                            "type": "mapping",
                            "mapping": "context.all_comb[].{ label: title, value: xrp }"
                        },
                        {
                            "type": "chart"
                        }
                    ]
                }
            ],
            "blockComment": ""
        }
    ],
    "id": "stats",
    "workflowId": "stats",
    "adapterName": "player",
    "created": "2026-01-28T18:47:10.114Z",
    "tags": [],
    "updated": "2026-01-28T18:47:10.114Z",
    "modified": "2026-01-28T18:47:10.114Z",
    "title": "Kendraio Player Statistics"
}