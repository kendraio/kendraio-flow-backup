                },
                {
                    "headerName": "Subscription Model",
                    "field": "subscriptionModel"
                },
                {
                    "headerName": "Genre",
                    "field": "genre"
                },
                {
                    "headerName": "Age Group",
                    "field": "ageGroup"
                }
            ],
            "passThrough": false,
            "firstRowHeaders": false,
            "blockComment": ""
        }
