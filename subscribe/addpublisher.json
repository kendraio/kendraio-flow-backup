            },
            "uiSchema": {},
            "blockComment": ""
        },
        {
            "type": "graphql",
            "endpoint": "https://kendraio-subscribe.hasura.app/v1/graphql",
            "query": "mutation MyMutation(\n    $name: String,\n    $websiteUrl: String,\n    $websiteLanguage: String,\n    $subscriptionModel: String,\n    $genre: String,\n    $ageGroup: String\n) \n{\n    insert_publishers(\n        objects: [\n            {\n                name: $name,\n                websiteUrl: $websiteUrl,\n                websiteLanguage: $websiteLanguage,\n                subscriptionModel: $subscriptionModel,\n                genre: $genre,\n                ageGroup: $ageGroup\n            }\n        ]\n    ) {\n        returning {\n            id\n            name\n            websiteUrl\n            websiteLanguage\n            subscriptionModel\n            genre\n            ageGroup\n        }\n    }\n}\n",
            "variables": {
                "name": "data.name",
                "websiteUrl": "data.websiteUrl",
                "websiteLanguage": "data.websiteLanguage",
                "subscriptionModel": "data.subscriptionModel",
                "genre": "data.genre",
                "ageGroup": "data.ageGroup"
            },
            "headers": {
                "x-hasura-admin-secret": "context.hasura.token"
            },
            "allowFirst": false,
            "allowEmpty": false
        },
        {
            "type": "graphql",
            "endpoint": "https://kendraio-subscribe.hasura.app/v1/graphql",
            "query": "query MyQuery {\n  publishers {\n    ageGroup\n    genre\n    id\n    name\n    subscriptionModel\n    websiteLanguage\n    websiteUrl\n  }\n}\n",
            "variables": {},
            "headers": {
                "x-hasura-admin-secret": "context.hasura.token"
            },
            "allowFirst": false,
            "allowEmpty": false
        },
