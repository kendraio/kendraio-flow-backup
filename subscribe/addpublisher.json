        {
            "type": "form",
            "emitOnInit": false,
            "jsonSchema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Publisher Name",
                        "default": "Publisher Name"
                    },
                    "websiteUrl": {
                        "type": "string",
                        "title": "Publisher Website",
                        "default": "Publisher Website"
                    },
                    "websiteLanguage": {
                        "type": "string",
                        "title": "Website Language",
                        "default": "Website Language"
                    },
                    "subscriptionModel": {
                        "type": "string",
                        "title": "Subscription Model",
                        "enum": [
                            "Free",
                            "Pooled"
                        ]
                    },
                    "genre": {
                        "type": "string",
                        "title": "Genre",
                        "default": "Genre"
                    },
