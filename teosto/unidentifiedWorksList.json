            "type": "mapping",
            "mapping": "context.searchForm.search!=null && \ndata[?\n    contains(toLower(worktitle), toLower(trim($.context.searchForm.search))) || \n    contains(to_string(workkey), toLower(trim($.context.searchForm.search))) || \n    contains(to_string(sequence), toLower(trim($.context.searchForm.search))) || \n    C[?contains(toLower(name), toLower(trim($.context.searchForm.search)))] || \n    A[?contains(toLower(name), toLower(trim($.context.searchForm.search)))] || \n    AR[?contains(toLower(name), toLower(trim($.context.searchForm.search)))] || \n    SA[?contains(toLower(name), toLower(trim($.context.searchForm.search)))] || \n    E[?contains(toLower(name), toLower(trim($.context.searchForm.search)))]\n] || data",
